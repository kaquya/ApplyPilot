# Copy to .env for Docker Compose. Keep real credentials out of Git.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
BILLING_ENABLED=false

# Optional AI integration. The tracker works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional payments. Configure and test every price and the webhook first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE=
STRIPE_PRO_PRICE=
STRIPE_LIFETIME_PRICE=

# Optional opt-in email reminders. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional S3-compatible storage. Empty bucket uses the documents volume.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=eu-central-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
